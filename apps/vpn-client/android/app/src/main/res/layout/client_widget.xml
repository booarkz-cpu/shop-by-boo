<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: state and the active server; a tap connects or disconnects. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- v1.8.2 (N12): Corgi Lusi asleep / running / happy, by the state. -->
    <ImageView
        android:id="@+id/widget_mascot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/mascot_sleep" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF1F5F9"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF94A3B8"
            android:textSize="12sp" />

        <!-- v1.8.2 (N12): the speed while connected, refreshed every few seconds. -->
        <TextView
            android:id="@+id/widget_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FFFF8A1F"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
