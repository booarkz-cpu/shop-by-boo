# Zero-downtime updates: BACKEND_UPSTREAM lists the backend and its standby (scripts/zero-downtime-backend.sh).
# The backend is always preferred; while it is being recreated, requests go to the standby that already
# runs the new release. Only requests that could not reach any upstream are retried, so nothing runs twice.
(backend_lb) {
    lb_policy first
    lb_try_duration 20s
    lb_try_interval 250ms
    fail_duration 10s
    health_uri /health/live
    health_interval 3s
    health_timeout 2s
}

{$ADMIN_DOMAIN} {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; img-src 'self' https: data:; connect-src 'self' https:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-src 'self' https://{$SUPPORT_PRO_DOMAIN}"
    }

    encode zstd gzip
    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle /media/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        reverse_proxy admin:80
    }
}

{$APP_DOMAIN} {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        # Telegram Web (web.telegram.org) embeds Mini Apps in an iframe; native clients use a webview.
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors https://web.telegram.org; object-src 'none'; img-src 'self' https: data:; connect-src 'self' https:; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'self' https://{$SUPPORT_PRO_DOMAIN}"
    }

    encode zstd gzip
    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle /media/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        reverse_proxy miniapp:80
    }
}

{$CABINET_DOMAIN} {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; img-src 'self' https: data:; connect-src 'self' https:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-src 'self' https://{$SUPPORT_PRO_DOMAIN}"
    }

    encode zstd gzip
    # App association for native passkeys (Android assetlinks, iOS webcredentials).
    handle /.well-known/assetlinks.json {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
        }
    }
    handle /.well-known/apple-app-site-association {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
        }
    }
    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle /media/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        reverse_proxy cabinet:80
    }
}

# API_MIRROR_DOMAINS: reserve API domains for the apps (anti_blocking.md), space separated; empty by default.
# SUB_PROXY_DOMAINS: domains of the subscription proxy (docs/modules/subscription_proxy.md): https://<domain>/<shortUuid>
# is served as /sub/<shortUuid>; empty by default (then the proxy answers at https://<API_DOMAIN>/sub/<shortUuid>).
{$API_DOMAIN} {$API_MIRROR_DOMAINS} {$SUB_PROXY_DOMAINS} {
    @subproxy not host {$API_DOMAIN} {$API_MIRROR_DOMAINS}
    rewrite @subproxy /sub{uri}
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; img-src 'self' https: data:; connect-src 'self' https:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }

    encode zstd gzip
    reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
            import backend_lb
            header_up X-Forwarded-For {remote_host}
        }
}

{$SUPPORT_PRO_DOMAIN} {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        -X-Frame-Options
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors https://{$ADMIN_DOMAIN}; object-src 'none'; img-src 'self' https: data:; connect-src 'self' https:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com"
    }
    encode zstd gzip
    reverse_proxy {$SUPPORT_UPSTREAM:support_pro:8000} {
        header_up X-Forwarded-For {remote_host}
    }
}
