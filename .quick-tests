gen:set -e
cd admin && npm ci --no-audit --no-fund >/dev/null && npm ci --prefix ../cabinet --no-audit --no-fund >/dev/null
npx playwright install --with-deps chromium >/dev/null 2>&1
npm run build >/dev/null && NEXT_BASE_PATH=/cabinet npm run build --prefix ../cabinet >/dev/null
cd ..
export BROWSER_DATABASE_URL=postgresql+asyncpg://vpnshop:ci-password@127.0.0.1:5432/vpnshop BROWSER_REDIS_URL=redis://127.0.0.1:6379/1 APP_ENV=test APP_SECRET=browser-test-only-secret-at-least-32-characters COOKIE_SECURE=false COOKIE_SAMESITE=lax MOBILE_REQUIRE_PROOF=false CUSTOMER_WEBAUTHN_ORIGIN=http://localhost:8777 WEBAUTHN_ORIGIN=http://localhost:8777 PAYMENTS_SANDBOX=true
python tests/passkey_browser_server.py > /tmp/server.log 2>&1 &
for i in $(seq 1 60); do curl -fsS http://localhost:8777/ >/dev/null 2>&1 && break; sleep 2; done
cd admin
mkdir -p ../_audit; node scripts/screenshots-catalog.mjs "$PWD/.." > ../_audit/catalog.txt 2>&1 || echo catalog-failed >> ../_audit/catalog.txt; cp /tmp/server.log ../_audit/server.txt
cp "$(node -e "console.log(require('os').tmpdir())")/admin-screenshots-index.json" ../_audit/index.json 2>/dev/null || true
cd ..
(cd cabinet && npm run build:miniapp > /dev/null 2>&1) && node scripts/screenshots/miniapp.mjs docs/img > _audit/miniapp.txt 2>&1 || echo miniapp-failed >> _audit/miniapp.txt
pip install -q numpy pillow playwright opencv-python-headless >/dev/null 2>&1; python -m playwright install --with-deps chromium >/dev/null 2>&1; python scripts/screenshots/bot_chat.py docs/img > _audit/bot.txt 2>&1 || echo bot-failed >> _audit/bot.txt
