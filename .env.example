# ============================================================
# Remnawave VPN Shop — .env.example
# Дистрибутив v28.26.0; runtime/API 21.5.1.
# Настройки текущей установки сохраняются при обновлении.
# Этот файл задаёт baseline. После миграции 0064 часть операционных значений
# можно переопределить в «Система → Настройки без перезапуска».
# Секреты в БД шифруются и не возвращаются в UI; корневые ключи, БД/Redis,
# домены, порты, mounts и образы остаются deployment-параметрами.
# Полный список и безопасный workflow: docs/ru/RUNTIME_SETTINGS_CURRENT.md
# ============================================================
# Как использовать:
#   1. cp .env.example .env
#   2. nano .env
#   3. Заполнить переменные с пометкой [ЗАПОЛНИТЬ]
#   4. Ctrl+O → Enter → Ctrl+X
#
# ⚠️ Обязательные переменные — без них проект не запустится:
#    BOT_TOKEN, ADMIN_EMAIL, ADMIN_PASSWORD,
#    REMNAWAVE_URL, REMNAWAVE_TOKEN,
#    DB_PASSWORD (= POSTGRES_PASSWORD = пароль в DATABASE_URL),
#    APP_SECRET
# ============================================================


# ============================================================
# 1. ПРИЛОЖЕНИЕ
# ============================================================

# [ЗАПОЛНИТЬ] Сгенерируйте: openssl rand -hex 32
APP_SECRET=change-me

# Старый ключ (только при ротации APP_SECRET). Оставьте пустым.
APP_SECRET_PREVIOUS=

# production | development
APP_ENV=production

# ru | en — язык по умолчанию для бота и Mini App, пока пользователь не выбрал свой
DEFAULT_LANGUAGE=ru

# true включает технический режим на уровне процесса (платежи отклоняются до чтения БД)
MAINTENANCE_MODE=false

# Часовой пояс
TZ=Europe/Moscow

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ============================================================
# 2. POSTGRESQL
# ============================================================
# ⚠️ ВАЖНО: DB_USER/PASSWORD/DATABASE_URL и POSTGRES_* должны совпадать.
# Пароль — только буквы и цифры (без @ : / # $ !).
# ============================================================

DB_USER=vpnshop
DB_NAME=vpnshop
# [ЗАПОЛНИТЬ]
DB_PASSWORD=ChangeMeToStrongDbPassword

POSTGRES_USER=vpnshop
POSTGRES_DB=vpnshop
# [ЗАПОЛНИТЬ] — должен совпадать с DB_PASSWORD выше
POSTGRES_PASSWORD=ChangeMeToStrongDbPassword

# [ЗАПОЛНИТЬ] — пароль здесь должен совпадать с DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://vpnshop:ChangeMeToStrongDbPassword@db:5432/vpnshop


# ============================================================
# 3. REDIS
# ============================================================

REDIS_URL=redis://redis:6379/0
# Production: уникальный пароль минимум 32 символа; installer генерирует автоматически.
REDIS_PASSWORD=change-me-generate-32-random-bytes
SUPPORT_REDIS_PASSWORD=change-me-generate-32-other-random-bytes
TRUSTED_PROXY_CIDRS=172.30.84.2/32
CADDY_INGRESS_IP=172.30.84.2
BACKEND_INGRESS_IP=172.30.84.3
INGRESS_SUBNET=172.30.84.0/29
CABINET_CORS_ORIGINS=


# ============================================================
# 4. TELEGRAM
# ============================================================

# [ЗАПОЛНИТЬ] Получите у @BotFather
BOT_TOKEN=

# [ЗАПОЛНИТЬ] Имя бота без @
BOT_USERNAME=

# [ЗАПОЛНИТЬ] Ваш ID (узнать у @userinfobot)
ADMIN_TELEGRAM_ID=


# ============================================================
# 5. REMNAWAVE API
# ============================================================

# [ЗАПОЛНИТЬ] Например: https://panel.example.com
REMNAWAVE_URL=

# [ЗАПОЛНИТЬ] Панель → Settings → API Tokens → Create
REMNAWAVE_TOKEN=
# Секрет вебхуков панели (WEBHOOK_SECRET_HEADER в .env Remnawave; адрес https://api.<домен>/api/webhooks/remnawave).
# Пусто — вебхуки не принимаются. Генерация: openssl rand -hex 32
REMNAWAVE_WEBHOOK_SECRET=

# Circuit breaker
REMNAWAVE_CB_FAILURES=5
REMNAWAVE_CB_COOLDOWN=30


# ============================================================
# 6. АДМИН-ПАНЕЛЬ
# ============================================================

# [ЗАПОЛНИТЬ]
ADMIN_EMAIL=admin@example.com

# [ЗАПОЛНИТЬ] Минимум 12 символов
ADMIN_PASSWORD=ChangeMeToStrongAdminPassword

# Только admin origins; cabinet origins задаются отдельно через CABINET_CORS_ORIGINS.
ADMIN_CORS_ORIGINS=

# Публичные URL
PUBLIC_BASE_URL=https://api.example.com
MINI_APP_URL=https://app.example.com
CABINET_URL=https://cabinet.example.com

# Cookies
COOKIE_SECURE=true
COOKIE_SAMESITE=none


# ============================================================
# 7. ДОМЕНЫ (Caddy)
# ============================================================
# Для локального теста — localhost.
# Для production — реальные домены.
# ============================================================

ADMIN_DOMAIN=localhost
APP_DOMAIN=localhost
API_DOMAIN=localhost
CABINET_DOMAIN=localhost
MINIAPP_DOMAIN=localhost
BOT_DOMAIN=localhost
WEBHOOK_DOMAIN=localhost
PANEL_DOMAIN=localhost

CADDY_EMAIL=admin@example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443


# ============================================================
# 8. ВАЛЮТА И ЦЕНЫ
# ============================================================

DEFAULT_CURRENCY=RUB

# Starter plans created on the first start when the shop has no plans (1, 3, 6, 12 months).
# They are created switched off: assign a Remnawave profile in «Тарифы» and enable them.
PRICE_1=199
PRICE_3=499
PRICE_6=899
PRICE_12=1499


# ============================================================
# 9. ПЛАТЁЖНЫЕ СИСТЕМЫ
# ============================================================
# Заполните только те, что используете.
# ============================================================

# --- YooKassa ---
YOOKASSA_API_URL=https://api.yookassa.ru
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Доверенные IP для вебхуков YooKassa (актуальный список)
YOOKASSA_WEBHOOK_IP_ALLOWLIST=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32

# --- Platega ---
PLATEGA_API_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_REFUND_URL=
PLATEGA_REFUND_STATUS_URL=

# --- RollyPay ---
ROLLYPAY_API_URL=https://rollypay.io
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_TEST_MODE=false
ROLLYPAY_REFUND_URL=
ROLLYPAY_REFUND_STATUS_URL=

# --- CryptoBot ---
CRYPTOBOT_TOKEN=
CRYPTOBOT_NETWORK=mainnet

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Общее ---
WEBHOOK_BASE_URL=https://shop.example.com


# ============================================================
# 10. БИЗНЕС-ЛОГИКА
# ============================================================

REFERRAL_REWARD_PERCENT=5.0
NOTIFICATION_EXPIRY_DAYS=3
AUTO_RENEW_ENABLED=false
# За сколько дней до окончания подписки запускать автопродление (1–14)
AUTO_RENEW_LEAD_DAYS=3
# Пусто = проверка выключена. Иначе @channel или числовой id чата.
REQUIRED_TELEGRAM_CHANNEL=
FULFILLMENT_MAX_ATTEMPTS=8
WORKER_ROLE=worker


# ============================================================
# 11. БЭКАПЫ S3 (опционально)
# ============================================================

BACKUP_S3_ENABLED=false
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=


# ============================================================
# 12. МОНИТОРИНГ И АЛЕРТЫ
# ============================================================

METRICS_ENABLED=true
METRICS_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Мобильные push-уведомления (необязательно; без ключей push выключен, центр уведомлений работает).
# Регламент: docs/ru/PUSH_NOTIFICATIONS_CURRENT.md
FCM_PROJECT_ID=
# JSON сервисного аккаунта Firebase (целиком или в base64). Храните только на сервере.
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=shop.remnawave.user
# Содержимое .p8-ключа APNs; переводы строк можно заменить на \n.
APNS_PRIVATE_KEY=
# production или sandbox (сборки Xcode Debug используют sandbox).
APNS_ENVIRONMENT=production

# Сетевая аналитика узлов: ASN, владелец сети и страна RIR из RIPEstat (без ключа),
# репутация IP из AbuseIPDB — только если задан ключ. Регламент: docs/ru/NETWORK_INTEL_CURRENT.md
NETWORK_INTEL_ENABLED=true
ABUSEIPDB_API_KEY=

# Почтовый домен: проверка MX/SPF/DKIM/DMARC и отчёты DMARC. Регламент: docs/ru/MAIL_DOMAIN_CURRENT.md
# Пусто — домен берётся из SMTP_FROM.
MAIL_DOMAIN=
# DNS-over-HTTPS (JSON API) для проверки записей.
MAIL_DNS_DOH_URL=https://cloudflare-dns.com/dns-query
# Ящик, куда приходят отчёты DMARC (адрес из rua=). Читается только на чтение; пусто — отчёты загружаются вручную.
DMARC_IMAP_HOST=
DMARC_IMAP_PORT=993
DMARC_IMAP_USER=
DMARC_IMAP_PASSWORD=
DMARC_IMAP_FOLDER=INBOX
# Хранение отчётов, дней.
DMARC_REPORT_RETENTION_DAYS=180

# Терминал узлов: оболочка на VPN-сервере через агент (нужно ещё AGENT_TERMINAL=1 на узле и 2FA у администратора).
# Регламент: docs/ru/NODE_TERMINAL_CURRENT.md
TERMINAL_ENABLED=false
TERMINAL_MAX_MINUTES=30
TERMINAL_IDLE_MINUTES=10
TERMINAL_TRANSCRIPT_DAYS=90

# Собственный приём почты (MX) для служебных адресов: сервис mail_receiver (docker compose --profile mail).
# Регламент: docs/ru/MAIL_RECEIVER_CURRENT.md
MAIL_RECEIVER_ENABLED=false
MAIL_RECEIVER_PORT=2525
# адрес=dmarc|support через запятую; другие адреса отклоняются (не open relay)
MAIL_RECEIVER_ROUTES=
MAIL_RECEIVER_HOSTNAME=
MAIL_RECEIVER_MAX_MB=10
MAIL_RECEIVER_GREYLIST=true
MAIL_RECEIVER_TLS_CERT=
MAIL_RECEIVER_TLS_KEY=
# clamd хост:порт (необязательно)
MAIL_RECEIVER_CLAMAV=
MAIL_SUPPORT_INBOUND_URL=http://support_pro:8000/email/inbound
# тот же секрет в support-pro/.env
MAIL_INBOUND_SECRET=


# ============================================================
# 13. БЕЗОПАСНОСТЬ
# ============================================================

FIREWALL_MODE=strict
REQUIRE_PINNED_IMAGES=true


# ============================================================
# 14. ВЕРСИИ ОБРАЗОВ (опционально)
# ============================================================

PYTHON_BASE_IMAGE=
NODE_BASE_IMAGE=
NGINX_BASE_IMAGE=
REDIS_IMAGE=
POSTGRES_IMAGE=
CADDY_IMAGE=


# ============================================================
# 15. РЕЛИЗЫ
# ============================================================

RELEASE_MANIFEST_URL=
RELEASE_MANIFEST_PUBLIC_KEY=


# ============================================================
# 16. КАТАЛОГИ, YANDEX ID
# ============================================================
# В Docker Compose эти пути совпадают с volumes. Для локального запуска
# без контейнеров укажите записываемые каталоги.

MEDIA_DIR=/data/media
BACKUPS_DIR=/data/backups
PROJECT_DIR=/project
BACKUP_S3_PREFIX=vpn-shop

# Необязательный вход Yandex ID. Пустые значения отключают провайдер.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=

# Необязательный вход VK ID.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

# Песочница платежей без живых шлюзов. Работает только при APP_ENV=development,
# test или staging. При APP_ENV=production процесс откажется стартовать.
# Пошаговый запуск без касс: docs/ru/TESTING.md и scripts/test-up.sh
PAYMENTS_SANDBOX=false
TRIAL_MAX_DAYS=3

# Native 2.14.0: одноразовый PKCE S256 exchange.
# Общий ключ не используется. Legacy HMAC запрещён в production.
# Старые приложения требуется пересобрать; false не включает legacy login.
MOBILE_CLIENT_KEY=
MOBILE_REQUIRE_PROOF=false


# ============================================================
# 17. ПОРТЫ (внутри Docker)
# ============================================================

BACKEND_PORT=8000
ADMIN_PORT=3000
MINIAPP_PORT=8080
CABINET_PORT=8081

# ============================================================
# SUPPORT PRO INTEGRATION
# ============================================================
# Same-site HTTPS hostname, e.g. support.example.com
SUPPORT_PRO_URL=https://support.example.com
# Generate with: openssl rand -hex 32
SUPPORT_PRO_SSO_SECRET=change-me-support-sso
SUPPORT_PRO_TIMEOUT_SECONDS=4
SUPPORT_PRO_DOMAIN=support.example.com
SUPPORT_PRO_BOT_TOKEN=
SUPPORT_PRO_PUBLIC_ORIGIN=https://support.example.com
SUPPORT_PRO_DB_PASSWORD=ChangeMeToStrongSupportDbPassword

# ---------- Corgi Payment Platform v20 ----------
# Checkout: only YooKassa, RollyPay and Platega (configured above).
# Historical provider credentials in an existing .env are settlement-only.
PAYMENT_ROUTER_ENABLED=true
PAYMENT_RISK_BLOCK_SCORE=90
PAYMENT_RISK_REVIEW_SCORE=60
AUTO_RENEW_GRACE_DAYS=3
AUTO_RENEW_MAX_RETRIES=5
DEFAULT_TAX_RATE=19.0

# Scoped machine key for canonical Support Pro conversations (empty disables bridge).
# Configure both .env files with scripts/configure-support-bridge.py.
SUPPORT_BRIDGE_TOKEN=

# Exact admin browser origin (HTTPS, no trailing slash); empty disables passkey ceremonies.
WEBAUTHN_ORIGIN=

# Exact HTTPS origins without a path; FeatureFlag passkeys must also be enabled.
CUSTOMER_WEBAUTHN_ORIGIN=https://cabinet.example.com
# Passkeys in the customer apps (docs/ru/NATIVE_PASSKEYS_CURRENT.md). The cabinet domain
# publishes /.well-known/assetlinks.json and apple-app-site-association from these values.
ANDROID_USER_PACKAGE=shop.remnawave.user
# SHA-256 fingerprints of the Android signing certificate (Play App Signing key if Google signs), comma-separated.
ANDROID_USER_CERT_SHA256=
# TEAMID.bundle-id of the iOS app; empty uses APNS_TEAM_ID and APNS_BUNDLE_ID.
IOS_USER_APP_ID=
