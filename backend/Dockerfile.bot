ARG PYTHON_BASE_IMAGE=python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
FROM ${PYTHON_BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN addgroup --system --gid 10001 app && adduser --system --uid 10001 --ingroup app app
COPY requirements.txt .
# The pip download cache lives in a BuildKit cache mount: rebuilds (also --no-cache ones) reuse the
# wheels, and the image itself carries no cache.
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic
COPY app ./app
# Bytecode compiled at build time: the read-only containers start without compiling.
RUN python -m compileall -q app
COPY bot-entrypoint.sh ./bot-entrypoint.sh
RUN chmod 0555 ./bot-entrypoint.sh
USER 10001:10001
ENTRYPOINT ["./bot-entrypoint.sh"]
