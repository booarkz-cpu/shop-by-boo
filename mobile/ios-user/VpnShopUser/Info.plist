<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSFaceIDUsageDescription</key>
    <string>Unlock your VPN Shop session with Face ID.</string>
    <key>CFBundleDisplayName</key>
    <string>Корги Люси</string>
    <key>CFBundleName</key>
    <string>VpnShopUser</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- Shop address baked into the build (CORGI_SHOP_URL build setting); empty keeps the address field. -->
    <key>CorgiShopURL</key>
    <string>$(CORGI_SHOP_URL)</string>
    <key>CFBundleURLTypes</key>
    <array><dict><key>CFBundleURLSchemes</key><array><string>corgi</string></array></dict></array>
    <!-- VPN clients the «Подключить» button hands the subscription to (canOpenURL). -->
    <key>LSApplicationQueriesSchemes</key>
    <array><string>happ</string><string>v2raytun</string><string>streisand</string><string>hiddify</string></array>
    <key>NSUserActivityTypes</key><array><string>shop.corgi.connect</string><string>shop.corgi.support</string></array>
</dict>
</plist>
