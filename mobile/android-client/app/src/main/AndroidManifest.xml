<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- «Держать устройство активным»: a partial wake lock while connected, only when the user turns it on. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The background subscription update survives a reboot (JobScheduler persisted job). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android TV: no touchscreen, no camera needed. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- v1.6.0 (N10): «Прокси по приложениям» lists every installed app (system ones too) to include or leave outside the
         tunnel — the VPN use case Google Play allows for this permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- «Приложения через VPN»: the list of launcher apps to include or leave outside the tunnel. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:banner="@mipmap/ic_launcher"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service android:name=".vpn.ClientVpnService" android:permission="android.permission.BIND_VPN_SERVICE" android:exported="false"
            android:foregroundServiceType="systemExempted|specialUse"
            tools:ignore="ForegroundServicePermission">
            <!-- systemExempted is allowed for a VpnService app with the VPN permission (no exact-alarm permission needed). -->
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local SOCKS5/HTTP proxy through Xray without a VPN interface («proxy only» mode chosen by the user)" />
        </service>
        <receiver android:name=".vpn.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".vpn.UpdateJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <service android:name=".vpn.QuickTile" android:exported="true" android:icon="@drawable/corgi_logo" android:label="@string/app_short"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <receiver android:name=".vpn.ClientWidget" android:exported="false" android:label="@string/app_short">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/client_widget_info" />
        </receiver>
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- Import: share links and subscription URLs from other apps, the browser or a QR code. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="trojan" />
                <data android:scheme="ss" />
                <data android:scheme="socks" />
                <data android:scheme="wireguard" />
                <data android:scheme="hysteria2" />
                <data android:scheme="hy2" />
            </intent-filter>
            <!-- The app's own links in a filter of their own: a host here would otherwise apply to the share-link schemes above.
                 corgi://connect, …/import/{base64}, …/restore/… (Tasker, shortcuts, links); corgiclient://import?url=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="corgi" />
                <data android:scheme="corgiclient" />
            </intent-filter>
        </activity>
        <!-- «Оформление → Иконка приложения»: one launcher entry per icon, exactly one enabled (AppIcons.kt). -->
        <activity-alias android:name=".ui.LauncherCorgi" android:targetActivity=".ui.MainActivity" android:exported="true"
            android:enabled="true" android:icon="@mipmap/ic_launcher" android:banner="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ui.LauncherNight" android:targetActivity=".ui.MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_night" android:banner="@mipmap/ic_launcher_night">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ui.LauncherMint" android:targetActivity=".ui.MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_mint" android:banner="@mipmap/ic_launcher_mint">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
