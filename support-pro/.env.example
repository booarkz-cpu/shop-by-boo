COMPOSE_PROJECT_NAME=support-pro-2
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
BOT_TOKEN=
DOMAIN=
LETSENCRYPT_EMAIL=
PUBLIC_ORIGIN=
COOKIE_SECURE=true
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50
# Optional provider supporting POST {AI_BASE_URL}/chat/completions.
# The URL must use HTTPS and include the API version prefix, e.g. /v1.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 3.4: permitted webhook hosts, comma-separated; HTTPS required
WEBHOOK_ALLOWED_HOSTS=
# Enable docker compose --profile antivirus up -d; then set host and enforce scanning.
CLAMAV_HOST=
CLAMAV_PORT=3310
REQUIRE_ANTIVIRUS=false

# Optional strong bearer token for a metrics collector. Empty: administrator session only.
METRICS_TOKEN=

SSO_SECRET=
PUBLIC_ORIGIN=

# Required for Redis server and clients. Generate with openssl rand -hex 32.
REDIS_PASSWORD=change-me-generate-32-random-bytes

# Canonical shop conversation bridge; optional in standalone deployments.
SHOP_BRIDGE_URL=
SHOP_BRIDGE_TOKEN=
SHOP_BRIDGE_INSTANCE=support-main

# 3.7: email support channel (optional). Empty EMAIL_IMAP_HOST disables intake.
# Guide: ../docs/ru/SUPPORT_EMAIL_CHANNEL_CURRENT.md
EMAIL_ADDRESS=
EMAIL_FROM_NAME=Служба поддержки
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
# ssl (port 993) or starttls (port 143)
EMAIL_IMAP_SECURITY=ssl
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_POLL_SECONDS=30
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
# starttls (port 587), ssl (port 465) or plain (trusted local relay only)
EMAIL_SMTP_SECURITY=starttls
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Attachment limit per email, MB.
EMAIL_MAX_MB=10
# Clear text and files of closed email tickets after N days; 0 keeps them.
EMAIL_RETENTION_DAYS=0
# Optional line appended to every reply, e.g. a link to the privacy policy.
EMAIL_PRIVACY_NOTICE=

# 3.8: external helpdesk bridge (optional): zendesk or freshdesk. Empty disables it.
# Guide: ../docs/ru/SUPPORT_HELPDESK_BRIDGE_CURRENT.md
HELPDESK_PROVIDER=
# Zendesk: subdomain (acme for acme.zendesk.com), agent email and API token.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# Freshdesk: domain (acme or acme.freshdesk.com) and agent API key.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
# First import starts here (ISO date, UTC); empty means the last 30 days.
HELPDESK_IMPORT_SINCE=
# Sync interval, seconds.
HELPDESK_SYNC_SECONDS=60
# Attachment limit per file, MB.
HELPDESK_MAX_MB=10

# 3.8: shop's own MX (optional). The same secret as MAIL_INBOUND_SECRET in the shop .env;
# empty disables POST /email/inbound. Guide: ../docs/ru/MAIL_RECEIVER_CURRENT.md
MAIL_INBOUND_SECRET=
